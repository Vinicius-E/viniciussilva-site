# Cloudflare Pages headers. Applied on deploy.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: browser-diagnostics=(), interest-cohort=()

# Long-cache fingerprinted build assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The résumé is a download, not a page — keep it out of the index
/vinicius-silva-cv.pdf
  X-Robots-Tag: noindex

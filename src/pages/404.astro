---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Page not found — Vinicius Silva" path="/404" description="That page doesn't exist.">
  <section class="nf">
    <div class="wrap">
      <p class="mono-label">404</p>
      <h1 class="nf__title">That page doesn't exist.</h1>
      <p class="nf__body">The link may be old, or the address slightly off.</p>
      <Button href="/" variant="solid">Back to the homepage</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(60px, 12vw, 140px);
  }
  .nf__title {
    font-size: var(--step-3);
    margin-block: var(--space-3) var(--space-3);
  }
  .nf__body {
    color: var(--color-ink-soft);
    margin-bottom: var(--space-5);
  }
</style>

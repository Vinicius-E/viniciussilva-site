---
import Button from '../ui/Button.astro';
import { site } from '../../lib/site';
import { getLangFromUrl, localizePath, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero">
  <div class="wrap hero__inner">
    <p class="eyebrow hero__eyebrow" data-reveal>{t.role}</p>
    <h1 class="hero__title" data-reveal style="--reveal-delay: 60ms">
      {t.hero.title}
    </h1>
    <p class="hero__sub" data-reveal style="--reveal-delay: 120ms">
      {t.hero.sub}
    </p>

    <div class="hero__ctas" data-reveal style="--reveal-delay: 180ms">
      <Button href={localizePath('/#work', lang)} variant="solid" analytics="cta_hero_work">
        {t.hero.ctaWork}
      </Button>
      <Button href={localizePath('/#contact', lang)} variant="outline" analytics="cta_hero_contact">
        {t.hero.ctaContact}
      </Button>
      <Button href={site.resumePath} variant="link" external download analytics="resume_download">
        {t.hero.resume}
      </Button>
    </div>

    <p class="hero__availability">{t.hero.availability}</p>
    <p class="hero__location">{t.hero.location}</p>
  </div>
</section>

<style>
  .hero {
    border-bottom: 1px solid var(--color-hairline);
    padding-block: clamp(44px, 8vw, 92px) clamp(32px, 6vw, 60px);
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .hero__eyebrow {
    color: var(--color-accent);
    letter-spacing: 0.18em;
  }
  .hero__title {
    font-size: var(--step-4);
    font-weight: 800;
    letter-spacing: -0.02em;
    max-width: 20ch;
    margin-block: var(--space-4) var(--space-5);
  }
  .hero__sub {
    font-size: clamp(1rem, 0.95rem + 0.6vw, 1.18rem);
    color: var(--color-ink-soft);
    max-width: 56ch;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-6);
  }
  .hero__availability {
    margin-top: var(--space-6);
    max-width: 62ch;
    color: var(--color-ink-soft);
    font-size: var(--step--1);
  }
  .hero__location {
    margin-top: var(--space-2);
    color: var(--color-steel);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
  }

  @media (max-width: 480px) {
    .hero__ctas > :global(.btn:not(.btn--link)) {
      flex: 1 1 100%;
      justify-content: center;
    }
  }

  /* stagger the hero reveal (see base.css .js [data-reveal]) */
  :global(.js) .hero [data-reveal] {
    transition-delay: var(--reveal-delay, 0ms);
  }
</style>

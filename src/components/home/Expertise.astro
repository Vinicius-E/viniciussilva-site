---
import SectionShell from '../layout/SectionShell.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const groups = t.expertise.groups;
---

<SectionShell
  id="expertise"
  label={t.expertise.label}
  heading={t.expertise.heading}
  intro={t.expertise.intro}
>
  <div class="expertise">
    {
      groups.map((g) => (
        <div class="expertise__group" data-reveal>
          <h3 class="expertise__name">{g.name}</h3>
          <ul class="expertise__items">
            {g.items.map((it) => (
              <li>{it}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</SectionShell>

<style>
  .expertise {
    display: grid;
    gap: var(--space-5) var(--space-6);
  }
  .expertise__group {
    border-top: 1px solid var(--color-hairline);
    padding-top: var(--space-4);
  }
  .expertise__name {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-steel);
    font-weight: 600;
  }
  .expertise__items {
    list-style: none;
    padding: 0;
    margin-top: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0;
  }
  .expertise__items li {
    font-size: 0.92rem;
    color: var(--color-ink);
  }
  .expertise__items li:not(:last-child)::after {
    content: '·';
    margin-inline: 10px;
    color: var(--color-hairline);
  }

  @media (min-width: 720px) {
    .expertise {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

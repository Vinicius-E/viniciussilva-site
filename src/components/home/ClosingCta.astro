---
import Button from '../ui/Button.astro';
import { getLangFromUrl, localizePath, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="closing" aria-label={t.closing.aria}>
  <div class="wrap closing__inner" data-reveal>
    <p class="closing__line">{t.closing.line}</p>
    <Button href={localizePath('/#contact', lang)} variant="solid" analytics="cta_footer_contact">
      {t.closing.cta}
    </Button>
  </div>
</section>

<style>
  .closing {
    border-bottom: 1px solid var(--color-hairline-soft);
    padding-block: var(--section-y);
  }
  .closing__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }
  .closing__line {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
    max-width: 34ch;
  }
</style>

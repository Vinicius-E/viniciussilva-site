---
/**
 * THE PEAK. A generic, anonymised architecture that assembles as the visitor
 * scrolls (the hero mesh "becomes the system"). Scroll progress is written to
 * --wp (0..1) by src/scripts/signal.ts; everything else is CSS.
 * Static fallback (no JS / reduced motion): --wp is 1, the full diagram and
 * the full list of steps are shown, nothing is pinned.
 */
import { buildMesh } from '../../lib/mesh';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = t.sys.peak;

interface N { id: string; x: number; y: number; w: number; h: number; label?: string; at: number; kind?: 'bus' | 'db' }
interface E { d: string; at: number; pulse?: boolean; dotted?: boolean }
interface Layout { w: number; h: number; nodes: N[]; edges: E[]; labels: { x: number; y: number; text: string; anchor?: string; at: number }[]; obs: { d: string; at: number }; seed: number; cols: number; rows: number }

const wide: Layout = {
  w: 1000, h: 520, seed: 31, cols: 9, rows: 5,
  nodes: [
    { id: 'client', x: 20, y: 228, w: 170, h: 64, label: p.nodes.client, at: 0.06 },
    { id: 'api', x: 250, y: 228, w: 240, h: 64, label: p.nodes.api, at: 0.24 },
    { id: 'bus', x: 570, y: 130, w: 24, h: 260, kind: 'bus', at: 0.4 },
    { id: 's1', x: 670, y: 136, w: 150, h: 52, at: 0.58 },
    { id: 's2', x: 670, y: 234, w: 150, h: 52, at: 0.62 },
    { id: 's3', x: 670, y: 332, w: 150, h: 52, at: 0.66 },
    { id: 'db', x: 870, y: 228, w: 110, h: 64, label: p.nodes.db, kind: 'db', at: 0.78 },
  ],
  edges: [
    { d: 'M190 260H250', at: 0.14, pulse: true },
    { d: 'M490 260H570', at: 0.32, pulse: true },
    { d: 'M594 260C625 260 640 162 670 162', at: 0.5 },
    { d: 'M594 260H670', at: 0.52, pulse: true },
    { d: 'M594 260C625 260 640 358 670 358', at: 0.54 },
    { d: 'M820 162C845 162 845 260 870 260', at: 0.7 },
    { d: 'M820 260H870', at: 0.72, pulse: true },
    { d: 'M820 358C845 358 845 260 870 260', at: 0.74 },
    { d: 'M370 292V470', at: 0.82, dotted: true },
    { d: 'M582 390V470', at: 0.84, dotted: true },
    { d: 'M745 386V470', at: 0.86, dotted: true },
  ],
  labels: [
    { x: 582, y: 420, text: p.nodes.bus, anchor: 'middle', at: 0.4 },
    { x: 745, y: 112, text: p.nodes.services, anchor: 'middle', at: 0.6 },
    { x: 20, y: 475, text: p.nodes.obs, anchor: 'start', at: 0.82 },
  ],
  obs: { d: 'M190 470H830', at: 0.8 },
};

const tall: Layout = {
  w: 360, h: 500, seed: 57, cols: 5, rows: 7,
  nodes: [
    { id: 'client', x: 80, y: 8, w: 200, h: 52, label: p.nodes.client, at: 0.06 },
    { id: 'api', x: 50, y: 100, w: 260, h: 52, label: p.nodes.api, at: 0.24 },
    { id: 'bus', x: 20, y: 192, w: 320, h: 24, kind: 'bus', at: 0.4 },
    { id: 's1', x: 20, y: 284, w: 96, h: 46, at: 0.58 },
    { id: 's2', x: 132, y: 284, w: 96, h: 46, at: 0.62 },
    { id: 's3', x: 244, y: 284, w: 96, h: 46, at: 0.66 },
    { id: 'db', x: 100, y: 394, w: 160, h: 52, label: p.nodes.db, kind: 'db', at: 0.78 },
  ],
  edges: [
    { d: 'M180 60V100', at: 0.14, pulse: true },
    { d: 'M180 152V192', at: 0.32, pulse: true },
    { d: 'M68 216V284', at: 0.5 },
    { d: 'M180 216V284', at: 0.52, pulse: true },
    { d: 'M292 216V284', at: 0.54 },
    { d: 'M68 330V362H180V394', at: 0.7 },
    { d: 'M180 330V394', at: 0.72, pulse: true },
    { d: 'M292 330V362H180', at: 0.74 },
  ],
  labels: [
    { x: 180, y: 240, text: p.nodes.bus, anchor: 'middle', at: 0.4 },
    { x: 180, y: 272, text: p.nodes.services, anchor: 'middle', at: 0.6 },
    { x: 180, y: 480, text: p.nodes.obs, anchor: 'middle', at: 0.82 },
  ],
  obs: { d: 'M20 464H340', at: 0.8 },
};

// scatter dots: start where a mesh node would be, converge onto the node outlines
function dots(l: Layout) {
  const scatter = buildMesh({ w: l.w, h: l.h, cols: l.cols, rows: l.rows, seed: l.seed, quietX: 0, maxLink: 0 }).nodes;
  const targets: [number, number][] = [];
  for (const n of l.nodes) {
    targets.push([n.x, n.y], [n.x + n.w, n.y], [n.x, n.y + n.h], [n.x + n.w, n.y + n.h], [n.x + n.w / 2, n.y]);
  }
  return scatter.map((s, i) => {
    const [tx, ty] = targets[i % targets.length];
    return { tx, ty, dx: Math.round(s.x - tx), dy: Math.round(s.y - ty) };
  });
}
const layouts = [
  { key: 'wide', l: wide, dots: dots(wide) },
  { key: 'tall', l: tall, dots: dots(tall) },
];
const stepAt = [0.05, 0.22, 0.4, 0.58, 0.76];
---

<div class="peak" data-peak>
  <div class="peak__stage">
    <div class="peak__text">
      <div class="peak__lead">
        <p class="mono-label">{p.label}</p>
        <h3 class="peak__heading">{p.heading}</h3>
        <p class="peak__intro">{p.intro}</p>
      </div>
      <ol class="peak__steps">
        {p.steps.map((s, i) => <li data-at={stepAt[i]}>{s}</li>)}
      </ol>
    </div>

    <div class="peak__figure">
      {
        layouts.map(({ key, l, dots: ds }) => (
          <svg
            class={`peak__svg peak__svg--${key}`}
            viewBox={`0 0 ${l.w} ${l.h}`}
            role="img"
            aria-label={p.diagramLabel}
            focusable="false"
          >
            <g class="pk-dots" aria-hidden="true">
              {ds.map((d) => (
                <circle class="pk-dot" cx={d.tx} cy={d.ty} r="2.4" style={`--dx:${d.dx};--dy:${d.dy}`} />
              ))}
            </g>
            <path class="pk-edge pk-edge--obs" d={l.obs.d} pathLength="1" style={`--at:${l.obs.at}`} />
            {l.edges.map((e) => (
              <path
                class={`pk-edge${e.dotted ? ' pk-edge--dotted' : ''}`}
                d={e.d}
                pathLength="1"
                style={`--at:${e.at}`}
              />
            ))}
            {l.edges.filter((e) => e.pulse).map((e, i) => (
              <path class="pk-pulse" d={e.d} pathLength="100" style={`--d:${(i * 0.7).toFixed(1)}s`} />
            ))}
            {l.nodes.map((n) => (
              <g class={`pk-node${n.kind ? ` pk-node--${n.kind}` : ''}`} style={`--at:${n.at}`}>
                <rect x={n.x} y={n.y} width={n.w} height={n.h} rx={n.kind === 'bus' ? 3 : 6} />
                {n.label && (
                  <text x={n.x + n.w / 2} y={n.y + n.h / 2 + 4} text-anchor="middle">
                    {n.label}
                  </text>
                )}
              </g>
            ))}
            {l.labels.map((lb) => (
              <text class="pk-label" x={lb.x} y={lb.y} text-anchor={lb.anchor ?? 'middle'} style={`--at:${lb.at}`}>
                {lb.text}
              </text>
            ))}
          </svg>
        ))
      }
    </div>
  </div>
</div>

<style>
  .peak {
    --wp: 1;
    margin-block: var(--space-6) var(--space-8);
  }
  .peak__stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    align-content: center;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    padding: var(--space-7) var(--space-6);
    background-image:
      linear-gradient(to right, var(--color-grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-grid) 1px, transparent 1px);
    background-size: 40px 40px;
  }
  .peak__text {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-4) var(--space-7);
    align-items: end;
  }
  .peak__heading {
    font-size: var(--step-3);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.02;
    margin-top: var(--space-3);
  }
  .peak__intro {
    margin-top: var(--space-3);
    color: var(--color-ink-soft);
    font-size: var(--step--1);
    max-width: 44ch;
  }
  .peak__steps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    border-left: 1px solid var(--color-hairline);
  }
  .peak__steps li {
    position: relative;
    padding-left: var(--space-4);
    font-size: var(--step-0);
    color: var(--color-ink-soft);
    transition: color var(--dur) var(--ease);
  }
  .peak__steps li::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid var(--color-accent);
    background: var(--color-surface);
  }
  .peak__steps li.is-on::before {
    background: var(--color-accent);
  }
  .peak__steps li.is-current {
    color: var(--color-ink);
  }

  /* ---- diagram ---- */
  .peak__svg {
    width: 100%;
    height: auto;
    max-height: calc(100svh - 330px);
    min-height: 240px;
    overflow: visible;
    --c: clamp(0, calc(var(--wp) * 1.6), 1);
  }
  .peak__svg--tall {
    display: none;
  }
  .pk-dot {
    fill: var(--color-accent);
    transform: translate(calc((1 - var(--c)) * var(--dx) * 1px), calc((1 - var(--c)) * var(--dy) * 1px));
    opacity: calc(1 - clamp(0, calc((var(--wp) - 0.5) * 4), 1));
  }
  .pk-edge {
    fill: none;
    stroke: var(--color-ink-soft);
    stroke-width: 1.4;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - clamp(0, calc((var(--wp) - var(--at)) * 6), 1));
  }
  .pk-edge--dotted,
  .pk-edge--obs {
    stroke: var(--color-steel);
    stroke-dasharray: 0.012 0.012;
    stroke-dashoffset: 0;
    opacity: clamp(0, calc((var(--wp) - var(--at)) * 8), 1);
  }
  .pk-node rect {
    fill: var(--color-raised);
    stroke: var(--color-ink);
    stroke-width: 1.2;
  }
  .pk-node--bus rect {
    fill: var(--color-accent);
    stroke: var(--color-accent);
  }
  .pk-node--db rect {
    fill: var(--color-ink);
  }
  .pk-node text {
    font-family: var(--font-mono);
    font-size: 16px;
    fill: var(--color-ink);
    letter-spacing: 0.02em;
  }
  .pk-node--db text {
    fill: var(--color-ground);
  }
  .pk-node,
  .pk-label {
    opacity: clamp(0, calc((var(--wp) - var(--at)) * 6), 1);
  }
  .pk-label {
    font-family: var(--font-mono);
    font-size: 13.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--color-ink-soft);
  }
  .pk-pulse {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 8 92;
    stroke-dashoffset: 100;
    opacity: clamp(0, calc((var(--wp) - 0.8) * 10), 1);
  }
  @media (prefers-reduced-motion: no-preference) {
    .pk-pulse {
      animation: pk-pulse 3.4s linear infinite;
      animation-delay: var(--d, 0s);
    }
    @keyframes pk-pulse {
      to {
        stroke-dashoffset: 0;
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pk-pulse {
      stroke-dashoffset: 50;
    }
  }

  /* ---- live (pinned) mode: only when JS says motion is OK ---- */
  :global(.peak--live) {
    height: 225vh;
    margin-block: var(--space-5) var(--space-6);
  }
  :global(.peak--live) .peak__stage {
    position: sticky;
    top: 68px;
    min-height: calc(100svh - 84px);
  }
  :global(.peak--live) .peak__steps {
    display: grid;
  }
  :global(.peak--live) .peak__steps li {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }
  :global(.peak--live) .peak__steps li.is-current {
    opacity: 1;
  }
  :global(.peak--live) .peak__steps {
    border-left: 0;
    min-height: 3.4em;
  }
  :global(.peak--live) .peak__steps li::before {
    display: none;
  }
  :global(.peak--live) .peak__steps li {
    padding-left: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.015em;
    line-height: 1.2;
    max-width: 24ch;
  }

  @media (max-width: 900px) {
    .pk-node text {
      font-size: 15px;
    }
    .pk-label {
      font-size: 12.5px;
    }
    .peak__stage {
      gap: var(--space-4);
      padding: var(--space-5) var(--space-4);
    }
    .peak__text {
      grid-template-columns: 1fr;
    }
    .peak__svg--wide {
      display: none;
    }
    .peak__svg--tall {
      display: block;
      width: auto;
      max-width: 100%;
      max-height: 52svh;
      min-height: 0;
      margin-inline: auto;
    }
    :global(.peak--live) {
      height: 200vh;
    }
    :global(.peak--live) .peak__intro {
      display: none;
    }
  }
</style>

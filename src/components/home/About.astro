---
import SectionShell from '../layout/SectionShell.astro';
import { site } from '../../lib/site';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const countryName = lang === 'en' ? 'Brazil' : 'Brasil';
const locationValue = `${site.location.city}, ${site.location.region}, ${countryName} · ${site.location.timezone}`;
---

<SectionShell id="about" label={t.about.label} heading={t.about.label}>
  <div class="about">
    <div class="about__text">
      <p>{t.about.p1}</p>
      <p>{t.about.p2}</p>

      <dl class="about__facts">
        <div>
          <dt>{t.about.factLocation}</dt>
          <dd>{locationValue}</dd>
        </div>
        <div>
          <dt>{t.about.factWork}</dt>
          <dd>
            {t.about.workValue}
          </dd>
        </div>
        <div>
          <dt>{t.about.factLanguages}</dt>
          <dd>{t.about.languagesValue}</dd>
        </div>
      </dl>
    </div>

    <figure class="about__photo">
      <img
        class="ph-photo"
        src="/vinicius-photo.jpg"
        width="720"
        height="1081"
        loading="lazy"
        alt={`${site.name} — ${t.role}`}
      />
    </figure>
  </div>
</SectionShell>

<style>
  .about {
    display: grid;
    gap: var(--space-6);
  }
  .about__text p + p {
    margin-top: var(--space-4);
  }
  .about__facts {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-3);
    border-top: 1px solid var(--color-hairline);
    padding-top: var(--space-4);
  }
  .about__facts div {
    display: grid;
    gap: 2px;
  }
  .about__facts dt {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-steel);
  }
  .about__facts dd {
    color: var(--color-ink-soft);
    font-size: 0.92rem;
  }

  .ph-photo {
    display: block;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    aspect-ratio: 4 / 5;
    max-width: 280px;
    width: 100%;
    object-fit: cover;
    object-position: 50% 25%;
  }

  @media (min-width: 720px) {
    .about {
      grid-template-columns: 2fr 1fr;
      align-items: start;
    }
    .about__photo {
      justify-self: end;
    }
  }
</style>

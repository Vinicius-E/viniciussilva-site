---
import SectionShell from '../layout/SectionShell.astro';
import Todo from '../ui/Todo.astro';
import { site } from '../../lib/site';
---

<SectionShell id="about" label="About" heading="About">
  <div class="about">
    <div class="about__text">
      <p>
        I'm a Senior Software Engineer with around five years building software for enterprise product
        teams and, more recently, directly for industrial clients. My focus is backend engineering in
        Java and Spring Boot, with the full-stack range to deliver a complete product and the habit
        of owning it from the first conversation to production.
      </p>
      <p>
        Working independently has made me a better engineer — it put me in the room for requirements,
        architecture, trade-offs, and the long tail of maintenance and evolution. I work through my
        own practice, {site.practice}.
      </p>

      <dl class="about__facts">
        <div>
          <dt>Location</dt>
          <dd>Based in {site.location.country} · {site.location.timezone}</dd>
        </div>
        <div>
          <dt>Work</dt>
          <dd>
            Remote, with international teams ·{' '}
            <Todo kind="verify">confirm public wording: “{site.location.relocation}”</Todo>
          </dd>
        </div>
        <div>
          <dt>Languages</dt>
          <dd>
            Portuguese (native) · English (professional,{' '}
            <Todo kind="verify">CEFR level</Todo>)
          </dd>
        </div>
      </dl>
    </div>

    <figure class="about__photo" aria-hidden="true">
      <div class="ph-photo">
        <span>headshot</span>
        <span class="ph-photo__todo">professional photo pending</span>
      </div>
    </figure>
  </div>
</SectionShell>

<style>
  .about {
    display: grid;
    gap: var(--space-6);
  }
  .about__text p + p {
    margin-top: var(--space-4);
  }
  .about__facts {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-3);
    border-top: 1px solid var(--color-hairline);
    padding-top: var(--space-4);
  }
  .about__facts div {
    display: grid;
    gap: 2px;
  }
  .about__facts dt {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-steel);
  }
  .about__facts dd {
    color: var(--color-ink-soft);
    font-size: 0.92rem;
  }

  .ph-photo {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: repeating-linear-gradient(
      45deg,
      var(--color-hairline-soft),
      var(--color-hairline-soft) 6px,
      transparent 6px,
      transparent 13px
    );
    aspect-ratio: 4 / 5;
    max-width: 280px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-steel);
  }
  .ph-photo__todo {
    font-size: 0.64rem;
    color: var(--color-warn);
    border: 1px dashed var(--color-warn);
    border-radius: var(--radius-sm);
    padding: 2px 8px;
    text-align: center;
  }

  @media (min-width: 720px) {
    .about {
      grid-template-columns: 2fr 1fr;
      align-items: start;
    }
    .about__photo {
      justify-self: end;
    }
  }
</style>

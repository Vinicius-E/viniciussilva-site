---
import SectionShell from '../layout/SectionShell.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const steps = t.how.steps.map((s, i) => ({ n: String(i + 1).padStart(2, '0'), ...s }));
---

<SectionShell id="approach" label={t.how.label} heading={t.how.heading}>
  <ol class="how">
    {
      steps.map((s) => (
        <li class="how__step" data-reveal>
          <span class="how__n">{s.n}</span>
          <h3 class="how__name">{s.name}</h3>
          <p class="how__line">{s.line}</p>
        </li>
      ))
    }
  </ol>
</SectionShell>

<style>
  .how {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-hairline);
  }
  .how__step {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-hairline-soft);
  }
  .how__n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-accent);
  }
  .how__name {
    font-size: 1.02rem;
    margin-top: 4px;
  }
  .how__line {
    color: var(--color-ink-soft);
    margin-top: 6px;
    max-width: 46ch;
  }

  @media (min-width: 900px) {
    .how {
      grid-template-columns: repeat(5, 1fr);
      border-top: 0;
    }
    .how__step {
      padding: var(--space-4) var(--space-4) var(--space-5) 0;
      border-bottom: 0;
      border-top: 2px solid var(--color-hairline);
    }
    .how__line {
      font-size: 0.88rem;
    }
  }
</style>

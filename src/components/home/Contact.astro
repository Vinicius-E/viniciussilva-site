---
import SectionShell from '../layout/SectionShell.astro';
import Button from '../ui/Button.astro';
import CopyText from '../ui/CopyText.astro';
import { site, mailtoHref } from '../../lib/site';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<SectionShell id="contact" label={t.nav.contact} heading={t.contact.heading}>
  <div class="contact">
    <p class="contact__sub">{t.hero.availability}</p>

    <div class="contact__actions">
      <Button href={mailtoHref} variant="solid" analytics="contact_email">{t.contact.emailMe}</Button>
      <Button href={site.socials.linkedin} variant="outline" external analytics="out_linkedin">
        {t.contact.linkedin}
      </Button>
      <Button href={site.socials.github} variant="outline" external analytics="out_github">
        {t.contact.github}
      </Button>
      <Button href={site.resumePath} variant="link" external download analytics="resume_download">
        {t.contact.resume}
      </Button>
    </div>

    <p class="contact__email">
      <CopyText
        value={site.contact.email}
        href={mailtoHref}
        analytics="contact_email"
        analyticsCopy="contact_email_copy"
        copyLabel={t.contact.copy}
        copiedLabel={t.contact.copied}
      />
    </p>
  </div>
</SectionShell>

<style>
  .contact__sub {
    font-size: clamp(1rem, 0.95rem + 0.4vw, 1.1rem);
    color: var(--color-ink-soft);
    max-width: 52ch;
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-5);
  }
  .contact__email {
    margin-top: var(--space-5);
  }
  @media (max-width: 480px) {
    .contact__actions > :global(.btn:not(.btn--link)) {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>

---
/**
 * Lightweight "zoom-out" band between Selected Work and Experience.
 * Spec §A/03: no card chrome, reduced padding, hero-family typography,
 * hairline-separated cells. Four short facts. "5+ years" is the only quantity.
 */
const items = [
  { label: '5+ years', line: 'Professional software engineering' },
  { label: 'Enterprise', line: 'Product teams and regulated domains' },
  { label: 'International', line: 'English-speaking, distributed teams' },
  { label: 'End-to-end', line: 'Requirements, architecture, delivery, evolution' },
];
---

<section id="snapshot" class="snapshot" aria-label="Engineering snapshot">
  <div class="wrap">
    <h2 class="sr-only">Engineering snapshot</h2>
    <dl class="snapshot__grid" data-reveal>
      {
        items.map((it) => (
          <div class="snapshot__cell">
            <dt>{it.label}</dt>
            <dd>{it.line}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .snapshot {
    padding-block: var(--section-y-tight);
    border-bottom: 1px solid var(--color-hairline-soft);
  }
  .snapshot__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--color-hairline-soft);
    border-block: 1px solid var(--color-hairline-soft);
  }
  .snapshot__cell {
    background: var(--color-ground);
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
  }
  .snapshot__cell:nth-child(odd) {
    padding-left: 0;
  }
  .snapshot__cell:nth-child(even) {
    padding-left: var(--space-4);
  }
  .snapshot__cell dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    color: var(--color-accent);
  }
  .snapshot__cell dd {
    margin-top: 4px;
    color: var(--color-ink-soft);
    font-size: var(--step--1);
  }

  @media (min-width: 700px) {
    .snapshot__grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .snapshot__cell,
    .snapshot__cell:nth-child(odd),
    .snapshot__cell:nth-child(even) {
      padding: 0 var(--space-4);
    }
    .snapshot__cell:first-child {
      padding-left: 0;
    }
    .snapshot__cell:last-child {
      padding-right: 0;
    }
  }
</style>

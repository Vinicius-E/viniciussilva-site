---
import Button from '../ui/Button.astro';

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  meta?: string;
  href?: string;
  slug?: string;
  featured?: boolean;
}
const { eyebrow, title, body, meta, href, slug, featured = false } = Astro.props;
---

<article class={`work-card${featured ? ' work-card--featured' : ''}`} data-reveal>
  <div class="work-card__text">
    <p class="work-card__eyebrow">{eyebrow}</p>
    <h3 class="work-card__title">{title}</h3>
    <p class="work-card__body">{body}</p>
    {meta && <p class="work-card__meta">{meta}</p>}
    {
      href && (
        <p class="work-card__cta">
          <Button href={href} variant="link" analytics="case_open" analyticsLabel={slug}>
            Read the full case study →
          </Button>
        </p>
      )
    }
    {!href && <slot name="note" />}
  </div>

  {
    featured && (
      <div class="work-card__media" aria-hidden="true">
        <div class="ph-figure">
          <span>screenshot · 2D layout / 3D view</span>
          <span class="ph-figure__todo">image pending — cleared screenshots to be supplied</span>
        </div>
      </div>
    )
  }
</article>

<style>
  .work-card {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    padding: var(--space-5);
    transition: border-color var(--dur) var(--ease);
  }
  .work-card:hover {
    border-color: var(--color-accent);
  }
  .work-card__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-steel);
  }
  .work-card__title {
    font-size: var(--step-1);
    margin-top: 6px;
  }
  .work-card--featured .work-card__title {
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.7rem);
  }
  .work-card__body {
    color: var(--color-ink-soft);
    margin-top: 10px;
    max-width: 52ch;
  }
  .work-card__meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-steel);
    margin-top: 14px;
    line-height: 1.6;
  }
  .work-card__cta {
    margin-top: 16px;
  }

  .work-card__media {
    margin-top: var(--space-5);
  }
  .ph-figure {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: repeating-linear-gradient(
      45deg,
      var(--color-hairline-soft),
      var(--color-hairline-soft) 6px,
      transparent 6px,
      transparent 13px
    );
    min-height: 200px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: var(--space-4);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-steel);
  }
  .ph-figure__todo {
    font-size: 0.66rem;
    color: var(--color-warn);
    border: 1px dashed var(--color-warn);
    border-radius: var(--radius-sm);
    padding: 2px 8px;
  }

  @media (min-width: 860px) {
    .work-card--featured {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: var(--space-6);
      align-items: center;
      padding: var(--space-6);
    }
    .work-card--featured .work-card__media {
      margin-top: 0;
      height: 100%;
    }
    .work-card--featured .ph-figure {
      height: 100%;
    }
  }
</style>

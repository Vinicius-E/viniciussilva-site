---
import { getCollection } from 'astro:content';
import SectionShell from '../layout/SectionShell.astro';
import WorkCard from './WorkCard.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const cases = (await getCollection('cases', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = cases.find((c) => c.data.featured) ?? cases[0];

const caseCta = lang === 'en' ? t.work.readCase : `${t.work.readCase} ${t.work.caseInEnglish}`;
---

<SectionShell
  id="work"
  label={t.work.label}
  heading={t.work.heading}
  intro={t.work.intro}
>
  {
    featured && (
      <WorkCard
        featured
        eyebrow={`${featured.data.clientDisplay} · ${featured.data.location}`}
        title={featured.data.title}
        body={featured.data.summary}
        meta={`${t.work.rolePrefix}: ${featured.data.role}  ·  ${[
          ...featured.data.stack.backend.slice(0, 3),
          ...featured.data.stack.frontend.slice(0, 1),
          ...featured.data.stack.mobile.slice(0, 1),
          ...featured.data.stack.frontend.slice(1, 2),
        ].join(' · ')}`}
        href={`/work/${featured.id}`}
        slug={featured.id}
        cta={caseCta}
        image={
          featured.data.screenshots[1]?.src
            ? { src: featured.data.screenshots[1].src, alt: featured.data.screenshots[1].alt }
            : undefined
        }
      />
    )
  }

  <div class="work-more">
    <article class="work-mini" data-reveal>
      <p class="work-mini__eyebrow">{t.work.mini1Eyebrow}</p>
      <h3 class="work-mini__title">{t.work.mini1Title}</h3>
      <p class="work-mini__body">{t.work.mini1Body}</p>
    </article>
    <article class="work-mini" data-reveal>
      <p class="work-mini__eyebrow">{t.work.mini2Eyebrow}</p>
      <h3 class="work-mini__title">{t.work.mini2Title}</h3>
      <p class="work-mini__body">{t.work.mini2Body}</p>
    </article>
  </div>

  <p class="work-note">{t.work.note}</p>
</SectionShell>

<style>
  .work-more {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .work-mini {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    padding: var(--space-5);
  }
  .work-mini__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-steel);
    line-height: 1.7;
  }
  .work-mini__title {
    font-size: 1.05rem;
    margin-top: 6px;
  }
  .work-mini__body {
    color: var(--color-ink-soft);
    font-size: 0.92rem;
    margin-top: 8px;
  }
  .work-note {
    margin-top: var(--space-5);
    color: var(--color-steel);
    font-size: var(--step--1);
    max-width: 60ch;
  }
  @media (min-width: 760px) {
    .work-more {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

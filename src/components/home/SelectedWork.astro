---
import SectionShell from '../layout/SectionShell.astro';
import Button from '../ui/Button.astro';
import WorkSystem from './WorkSystem.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, localizePath, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const L = t.sys.caseLabels;

const cases = await getCollection('cases', ({ data }) => !data.draft);
const featured = cases.find((c) => c.data.featured) ?? cases[0];
const caseCta = lang === 'en' ? t.work.readCase : `${t.work.readCase} ${t.work.caseInEnglish}`;

const thumbs = [
  { src: '/portfolio/control-tower.webp', w: 1200, h: 833 },
  { src: '/portfolio/acesso-revisado.webp', w: 1200, h: 886 },
  { src: '/portfolio/contrato-alerta.webp', w: 1200, h: 886 },
];
---

<SectionShell id="work" label={t.work.label} heading={t.work.heading} intro={t.work.intro}>
  <WorkSystem />

  <div class="cases">
    {
      t.sys.cases.map((c) => (
        <article class="case" data-reveal>
          <header class="case__head">
            <p class="case__tag">{c.tag}</p>
            <h3 class="case__title">{c.title}</h3>
            {c.href && featured && (
              <p class="case__link">
                <Button
                  href={`/work/${featured.id}`}
                  variant="link"
                  analytics="case_open"
                  analyticsLabel={featured.id}
                >
                  {caseCta}
                </Button>
              </p>
            )}
          </header>
          <dl class="case__body">
            <div>
              <dt>{L.problem}</dt>
              <dd>{c.problem}</dd>
            </div>
            <div>
              <dt>{L.built}</dt>
              <dd>{c.built}</dd>
            </div>
            <div>
              <dt>{L.stack}</dt>
              <dd class="case__stack">{c.stack}</dd>
            </div>
            <div>
              <dt>{L.result}</dt>
              <dd>{c.result}</dd>
            </div>
          </dl>
        </article>
      ))
    }
  </div>

  <p class="work-note">{t.work.note}</p>

  <a class="teaser" id="portfolio" href={localizePath('/portfolio', lang)} data-analytics="cta_portfolio" data-reveal>
    <div class="teaser__thumbs" aria-hidden="true">
      {thumbs.map((i) => <img src={i.src} width={i.w} height={i.h} alt="" loading="lazy" decoding="async" />)}
    </div>
    <div class="teaser__text">
      <p class="mono-label">{t.nav.portfolio}</p>
      <h3 class="teaser__heading">{t.sys.portfolio.heading}</h3>
      <p class="teaser__body">{t.sys.portfolio.body}</p>
      <span class="teaser__cta">{t.sys.portfolio.cta} <span aria-hidden="true">→</span></span>
    </div>
  </a>
</SectionShell>

<style>
  .cases {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-ink);
  }
  .case {
    display: grid;
    gap: var(--space-4) var(--space-7);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-hairline);
  }
  .case__tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-steel);
    line-height: 1.7;
  }
  .case__title {
    font-size: var(--step-2);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-top: var(--space-2);
  }
  .case__link {
    margin-top: var(--space-3);
  }
  .case__body {
    display: grid;
    gap: var(--space-4);
  }
  .case__body > div {
    display: grid;
    gap: 4px var(--space-4);
  }
  .case__body dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    padding-top: 0.25em;
  }
  .case__body dd {
    color: var(--color-ink-soft);
    max-width: 62ch;
  }
  .case__stack {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-ink);
  }
  .work-note {
    margin-top: var(--space-5);
    color: var(--color-steel);
    font-size: var(--step--1);
    max-width: 60ch;
  }

  .teaser {
    display: grid;
    gap: var(--space-5) var(--space-7);
    margin-top: var(--space-8);
    padding: var(--space-5);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .teaser:hover {
    border-color: var(--color-accent);
    color: inherit;
  }
  .teaser__thumbs {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    align-self: center;
  }
  .teaser__thumbs img {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top;
    width: 100%;
    height: auto;
  }
  .teaser__heading {
    font-size: var(--step-2);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-top: var(--space-2);
  }
  .teaser__body {
    margin-top: var(--space-3);
    color: var(--color-ink-soft);
  }
  .teaser__cta {
    display: inline-block;
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  @media (min-width: 860px) {
    .case {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
    .case__body > div {
      grid-template-columns: 7.5rem minmax(0, 1fr);
    }
    .teaser {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      padding: var(--space-6);
    }
  }
</style>

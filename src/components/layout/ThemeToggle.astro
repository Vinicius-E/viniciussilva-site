---
/* Theme toggle. Reflects and persists the explicit choice; falls back to the
   OS setting when unset. With motion allowed, the switch is a circular reveal
   from the button (View Transitions API); otherwise it is instant. */
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const t = useTranslations(getLangFromUrl(Astro.url));
---

<button type="button" class="theme-toggle" id="theme-toggle" aria-label={t.a11y.theme}>
  <span class="theme-toggle__dot" aria-hidden="true"></span>
  <span class="theme-toggle__txt">{t.a11y.themeLabel}</span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    background: transparent;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    padding: 7px 12px;
    min-height: 36px;
    cursor: pointer;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .theme-toggle:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .theme-toggle__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px solid currentColor;
    background: linear-gradient(90deg, currentColor 0 50%, transparent 50% 100%);
  }
</style>

<script>
  const btn = document.getElementById('theme-toggle');
  const root = document.documentElement;
  function current(): 'dark' | 'light' {
    if (root.dataset.theme === 'dark' || root.dataset.theme === 'light') return root.dataset.theme;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }
  function apply(next: 'dark' | 'light') {
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage blocked — the toggle still works for this session */
    }
  }
  btn?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    const doc = document as Document & { startViewTransition?: (cb: () => void) => { ready: Promise<void> } };
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!doc.startViewTransition || calm || !btn) {
      apply(next);
      return;
    }
    const r = btn.getBoundingClientRect();
    const x = r.left + r.width / 2;
    const y = r.top + r.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    const vt = doc.startViewTransition(() => apply(next));
    vt.ready
      .then(() => {
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          { duration: 650, easing: 'cubic-bezier(0.2, 0.6, 0.2, 1)', pseudoElement: '::view-transition-new(root)' },
        );
      })
      .catch(() => {});
  });
</script>

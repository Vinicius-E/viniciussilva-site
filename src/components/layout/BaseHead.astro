---
import '../../styles/fonts.css';
import '../../styles/tokens.css';
import '../../styles/base.css';
import { site } from '../../lib/site';
import { clientScript } from '../../lib/analytics';

interface Props {
  title: string;
  description?: string;
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: unknown[];
}

const {
  title,
  description = site.metaDescription,
  path,
  ogImage = '/og/home.png',
  ogType = 'website',
  jsonLd = [],
} = Astro.props;

const canonical = new URL(path, site.url).href;
const ogImageUrl = new URL(ogImage, site.url).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="author" content={site.legalName} />
<meta name="robots" content="index, follow" />
<meta name="theme-color" content="#0e0d10" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#f1ede6" media="(prefers-color-scheme: light)" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/fonts/archivo-latin.woff2"
  crossorigin="anonymous"
/>
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href="/fonts/ibm-plex-sans-latin-400.woff2"
  crossorigin="anonymous"
/>

<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en" />
<meta property="og:site_name" content={`${site.name} — ${site.role}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<link rel="alternate" hreflang="en" href={canonical} />

{/* Runs before first paint: mark JS available (gates reveal animations) and
   apply a saved theme so there's no flash. */}
<script is:inline>
  (function () {
    document.documentElement.classList.add('js');
    try {
      var t = localStorage.getItem('theme');
      if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
    } catch (e) {}
  })();
</script>

{jsonLd.map((block) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
))}

{/* analytics foundation — no third-party script yet (see lib/analytics.ts) */}
<script is:inline set:html={clientScript} />

<style is:global>
  /* keep the fold stable while the display font loads */
  :root {
    font-family: var(--font-body);
  }
</style>

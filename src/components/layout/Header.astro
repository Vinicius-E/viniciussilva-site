---
import { primaryNav, site } from '../../lib/site';
import FalconMark from '../brand/FalconMark.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitcher from './LangSwitcher.astro';
import { getLangFromUrl, localizePath, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navLabels: Record<string, string> = {
  '/#work': t.nav.work,
  '/portfolio': t.nav.portfolio,
  '/#experience': t.nav.experience,
  '/#expertise': t.nav.expertise,
  '/#contact': t.nav.contact,
};
const nav = primaryNav.map((item) => ({
  label: navLabels[item.href] ?? item.label,
  href: localizePath(item.href, lang),
}));
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href={localizePath('/', lang)} class="site-header__id" aria-label={`${site.name} — home`}>
      <FalconMark size={20} />
      <span class="site-header__name">Vinicius Silva</span>
    </a>

    <nav class="site-header__nav" aria-label={t.a11y.primaryNav}>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="site-header__actions">
      <LangSwitcher />
      <ThemeToggle />
      <a
        class="site-header__resume"
        href={site.resumePath}
        target="_blank"
        rel="noopener"
        data-analytics="resume_download"
      >
        {t.header.resume} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--color-ground) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-hairline);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 56px;
    padding-block: 8px;
  }
  .site-header__id {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: var(--color-ink);
    flex-shrink: 0;
  }
  .site-header__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.92rem;
    letter-spacing: 0.005em;
  }
  .site-header__nav {
    display: none;
    gap: var(--space-5);
  }
  .site-header__nav a {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    text-decoration: none;
  }
  .site-header__nav a:hover {
    color: var(--color-accent);
  }
  .site-header__actions {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }
  .site-header__resume {
    display: none;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    padding: 8px 14px;
    min-height: 36px;
  }
  .site-header__resume:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  @media (min-width: 700px) {
    .site-header__nav {
      display: inline-flex;
    }
  }
  @media (min-width: 900px) {
    .site-header__resume {
      display: inline-flex;
    }
  }
</style>

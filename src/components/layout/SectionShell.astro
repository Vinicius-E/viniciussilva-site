---
/**
 * Every homepage section passes through here so vertical rhythm, the label +
 * heading pattern and the anchor id live in one place and the cascade can't
 * drift. Approved spec §D.
 */
interface Props {
  id: string;
  label: string;
  heading: string;
  /** hide the <h2> visually but keep it for the document outline / SEO */
  headingHidden?: boolean;
  intro?: string;
  tight?: boolean;
  class?: string;
}
const { id, label, heading, headingHidden = false, intro, tight = false, class: klass } = Astro.props;
---

<section
  id={id}
  class={`section${tight ? ' section--tight' : ''}${klass ? ` ${klass}` : ''}`}
  data-signal={label}
>
  <div class="wrap">
    <div class="section__head" data-reveal>
      <p class="mono-label">{label}</p>
      <h2 class={headingHidden ? 'sr-only' : 'section__heading'}>{heading}</h2>
      {intro && <p class="section__intro">{intro}</p>}
    </div>
    <div class="section__body">
      <slot />
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: var(--section-y);
    border-bottom: 1px solid var(--color-hairline-soft);
  }
  .section--tight {
    padding-block: var(--section-y-tight);
  }
  .section__head {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    padding-top: var(--space-5);
  }
  /* scan line: a terracotta hairline sweeps across the section top when it enters */
  .section__head::before,
  .section__head::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    height: 1px;
    width: 100%;
    background: var(--color-hairline);
  }
  .section__head::after {
    background: var(--color-accent);
    width: 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .section__head::after {
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 900ms var(--ease) 120ms;
    }
    :global(.js) .section__head.is-visible::after {
      transform: scaleX(0.18);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .section__head::after {
      transform: scaleX(0.18);
      transform-origin: left center;
    }
  }
  .section__heading {
    font-size: var(--step-3);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.04;
    max-width: 20ch;
  }
  .section__intro {
    color: var(--color-ink-soft);
    max-width: var(--measure);
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortfolioHero from './PortfolioHero.astro';
import PortfolioProjects from './PortfolioProjects.astro';
import PortfolioCatalog from './PortfolioCatalog.astro';
import { site } from '../../lib/site';
import { pageUi } from '../../lib/portfolio-index';
import { getLangFromUrl, localizePath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const ui = pageUi[lang];
---

<BaseLayout title={`${ui.seoTitle} · ${site.name}`} description={ui.intro} path={localizePath('/portfolio', lang)}>
  <PortfolioHero />
  <PortfolioProjects />
  <PortfolioCatalog />
</BaseLayout>
